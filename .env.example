ENVIRONMENT=dev            # dev | test | prod
LOG_LEVEL=INFO

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

EMBEDDING_MODEL=BAAI/bge-m3
# Vérifie le nom du modèle disponible sur ton compte : https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-2.5-flash
# Clé gratuite : https://aistudio.google.com/apikey (utile à partir du J3)
GEMINI_API_KEY=

MAX_AGENT_ITERATIONS=3
MAX_TOOL_CALLS=8

# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60